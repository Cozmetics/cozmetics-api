# Cozmetics Publishing Service Configuration Example

# Network
PORT=3001
HOST=0.0.0.0

# Base public URL for downloading packages and thumbnails
# Target production domain: https://catalog.cozmetics.arcn.online
BASE_URL=https://catalog.cozmetics.arcn.online

# Storage directory (outside repository source in production)
DATA_DIR=./data

# Session encryption secret (generate a strong random secret in production)
SESSION_SECRET=replace-with-a-very-long-random-secret-key-for-sessions

# Node environment (development | production)
NODE_ENV=production

